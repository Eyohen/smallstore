# Public browser configuration. Vite embeds every VITE_* value in the bundle.
# A pk_ key is intentionally public; never put API secrets or webhook secrets here.
VITE_URL=https://your-smallstore-api.example.com
VITE_STABLEZACT_API_URL=https://your-staging-stablezact-api.example.com
VITE_STABLEZACT_PUBLIC_KEY=pk_test_replace_me
VITE_STABLEZACT_WEBHOOK_URL=https://your-smallstore-api.example.com/api/webhooks/stablezact
